generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TWK
  TIU
  TKP
}

model Question {
  id          Int      @id @default(autoincrement())
  category    Category
  subCategory String?
  text        String
  explanation String
  options     Option[]
  createdAt   DateTime @default(now())
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  label      String
  score      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  totalQuestions Int
  twkScore       Int
  tiuScore       Int
  tkpScore       Int
  totalScore     Int
}
